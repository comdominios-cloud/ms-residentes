# ---- Aplicacion ----
APP_NAME=ms-residentes
# Puerto DENTRO del contenedor
APP_PORT=8000
# Puerto publicado en la VM de produccion (rango asignado por el curso: 9000-12000)
PUBLISHED_PORT=9001
APP_ENV=development
LOG_LEVEL=info

# ---- Base de datos PostgreSQL (contenedor en la VM de base de datos) ----
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=condominio_residentes
POSTGRES_USER=
POSTGRES_PASSWORD=

# Cadena de conexion completa (opcional)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/condominio_residentes

# ---- Autenticacion (login / register) ----
# Generar con: openssl rand -hex 32   -- NUNCA commitear el valor real
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
