# ---- Aplicacion ----
APP_NAME=ms-residentes
APP_PORT=8001
APP_ENV=development
LOG_LEVEL=info

# ---- Base de datos MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=condominio_residentes
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Cadena de conexion completa (opcional, si no se arma desde las variables anteriores)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/condominio_residentes
